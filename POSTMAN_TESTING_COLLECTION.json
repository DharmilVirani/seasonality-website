                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/analysis/performance",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "analysis",
                                "performance"
                            ]
                        },
                        "description": "Get performance metrics for all services"
                    }
                },
                {
                    "name": "6.2 Clear Cache",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
