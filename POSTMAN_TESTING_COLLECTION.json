                        },
                        "description": "Get upload processing statistics"
                    }
                }
            ]
        },
        {
            "name": "7. Data Verification",
            "item": [
                {
                    "name": "7.1 Get Tickers",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/data/tickers",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
